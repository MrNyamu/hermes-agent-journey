#!/bin/sh
# git credential helper: picks the token from the owner in the URL path.
# Needs: git config --global credential.https://github.com.useHttpPath true
[ "$1" = get ] || exit 0
while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = path ] && p="$v"; done
tok=$(/root/bin/ghtok "${p%%/*}") || exit 0
echo username=x-access-token
echo "password=$tok"
